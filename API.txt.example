# Copy to API.txt and fill in real keys.  API.txt is git-ignored.
#
# The agent is PLANNER-ONLY: it reads JSON state and picks tools, and never
# sees images.  All perception is handled by dedicated models:
#   detection + segmentation : SAM3 (or GroundingDINO + SAM2)
#   3D reconstruction        : VGGT
#   metric scale             : MoGe
#
# So there is a single model role here, and it only needs to be text-capable.

# ---------------------------------------------------------------------
# Planner.  Any OpenAI-compatible endpoint works.
#
# Hosted example:
#   export AGENT_PLANNER_MODEL='qwen3.7-plus'
#   export AGENT_PLANNER_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
#   export AGENT_PLANNER_API_KEY='sk-REPLACE_ME'
#
# Local vLLM (see scripts/serve_planner_local.sh):
#   export AGENT_PLANNER_MODEL='qwen3-30b-a3b'
#   export AGENT_PLANNER_BASE_URL='http://127.0.0.1:8000/v1'
#   export AGENT_PLANNER_API_KEY='local'
#
# Local hybrid Qwen3 checkpoints think by default, which burns the Planner's
# token budget and can truncate the JSON decision.  Disable it with:
#   export GCA_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
# ---------------------------------------------------------------------
export AGENT_PLANNER_MODEL='qwen3.7-plus'
export AGENT_PLANNER_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
export AGENT_PLANNER_API_KEY='sk-REPLACE_ME'

# ---------------------------------------------------------------------
# Legacy single-model configuration (still supported).
# Used when AGENT_PLANNER_* is incomplete.
# ---------------------------------------------------------------------
export AGENT_COT_REASONER_MODEL='qwen3.7-plus'
export AGENT_COT_REASONER_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
export AGENT_COT_REASONER_API_KEY='sk-REPLACE_ME'
export AGENT_COT_REASONER_PROXY=''

# ---------------------------------------------------------------------
# Optional code/tool-generation model (only used with
# --allow-tool-generation, and as a last-resort role fallback).
# ---------------------------------------------------------------------
export AGENT_CODE_GENERATOR_MODEL='qwen3.7-plus'
export AGENT_CODE_GENERATOR_BASE_URL='https://dashscope.aliyuncs.com/compatible-mode/v1'
export AGENT_CODE_GENERATOR_API_KEY='sk-REPLACE_ME'
export AGENT_CODE_GENERATOR_PROXY=''
